{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Axe Tabber",
  "version": "../package.json",
  "identifier": "com.danmactough.axetabber",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Axe Tabber",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_CONTENTS_OF_~/.tauri/axe-tabber.key.pub",
      "endpoints": [
        "https://github.com/danmactough/axe-tabber/releases/latest/download/latest.json"
      ]
    }
  }
}
